#!/usr/bin/env bash
set -e

cd "$(dirname "$0")"

echo ""
echo "================================"
echo "  Job Card System Launcher"
echo "================================"
echo ""

# Check Node.js
if ! command -v node &> /dev/null; then
    echo "ERROR: Node.js not found."
    echo ""
    echo "Please install Node.js 18+ from:"
    echo "  https://nodejs.org"
    echo ""
    exit 1
fi

NODE_VERSION=$(node -v | cut -d'v' -f2 | cut -d'.' -f1)
if [ "$NODE_VERSION" -lt 18 ]; then
    echo "ERROR: Node.js 18+ required."
    echo "Found: $(node -v)"
    echo ""
    echo "Please upgrade from: https://nodejs.org"
    exit 1
fi

echo "Node.js $(node -v) detected"

# Detect WSL
IS_WSL=false
if grep -qEi "(microsoft|wsl)" /proc/version 2>/dev/null; then
    IS_WSL=true
    echo "WSL environment detected - running in web mode (no Electron)"
fi
echo ""

# Install root dependencies if needed
if [ ! -d "node_modules" ]; then
    echo "Installing root dependencies..."
    npm install
    echo ""
fi

# Run setup checks
node scripts/setup.js

# Check for restart flag
if [ "$1" = "--restart" ] || [ "$1" = "-r" ]; then
    echo "Restarting services..."
    pkill -f "node.*server" 2>/dev/null || true
    pkill -f "vite" 2>/dev/null || true
    pkill -f "electron" 2>/dev/null || true
    sleep 1
fi

# Check for web-only flag
if [ "$1" = "--web" ] || [ "$1" = "-w" ]; then
    IS_WSL=true
fi

# Start the application
echo "Starting Job Card System..."
echo "  Server API: http://localhost:3000"
echo "  Client:     http://localhost:5173"
echo "  Database:   data/jobcard.db (SQLite)"
echo ""
echo "Press Ctrl+C to stop"
echo ""

ROOT_DIR="$(pwd)"

if [ "$IS_WSL" = true ]; then
    # Web-only mode: run server and vite dev server (no Electron)
    (cd "$ROOT_DIR/server" && npm start) &
    SERVER_PID=$!
    sleep 2
    cd "$ROOT_DIR/client" && npm run start:web
    kill $SERVER_PID 2>/dev/null || true
else
    # Full mode with Electron
    npm start
fi
