# Copy this file to `.env` in the same folder and fill in the real values.
# `.env` is git-ignored — it never leaves this machine.

# OpenRouter key, used for TypeSafe/Jev decision calls.
# Create at https://openrouter.ai/keys and set a low credit limit on it.
OPENROUTER_API_KEY=

# Only needed if code is written against the TypeSafe SDK instead of plain
# HTTP calls: the SDK looks for its own variable name, pointed at OpenRouter.
# TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://openrouter.ai/api
