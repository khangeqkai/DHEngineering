    { "value": "MEDIUM", "label": "Medium" },
    { "value": "HIGH", "label": "High" },
    { "value": "SAME_DAY", "label": "Same Day Service" }
  ],
  "defaultStatus": "OPEN",
  "closedStatus": "ARCHIVED",
  "alertStatus": "ACTION_REQUIRED",
  "billedStatus": "CALL_FOR_PAYMENT",
  "billedStatuses": ["CALL_FOR_PAYMENT", "ARCHIVED"],
  "billingStatuses": ["TO_INVOICE", "CALL_FOR_PAYMENT", "ARCHIVED"],
  "settledStatuses": ["DONE", "READY_TO_COLLECT", "TO_COST", "TO_INVOICE", "CALL_FOR_PAYMENT", "ARCHIVED"]
